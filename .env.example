# Copy this file to .env and fill in your keys.
# Never commit .env - it is in .gitignore.

# --- Core access (all three required) ---

# Language model: fill in ONE of these. Gemini first, Groq as fallback.
GEMINI_API_KEY=
GROQ_API_KEY=

# Web search: fill in ONE of these. You already have Tavily.
TAVILY_API_KEY=
EXA_API_KEY=

# GitHub: username alone is enough for the check.
# A token (classic, no scopes needed) gives a stronger check if you want one.
GITHUB_USERNAME=
GITHUB_TOKEN=

# --- Sources (need at least one working) ---
# Bluesky and Hacker News need no keys at all.

YOUTUBE_API_KEY=

# --- Optional ---

# Set to 1 to skip the Apple App Store check
SKIP_APP_STORE=

# Tracing: Langfuse OR LangSmith
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

LANGSMITH_API_KEY=
